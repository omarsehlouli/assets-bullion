              "eduQuestionType": "Multiple choice",
              "learningResourceType": "Practice problem",
              "name": "Which property below is unique to physical gold compared to stocks, bonds, or bank deposits?",
              "text": "Which property below is unique to physical gold compared to stocks, bonds, or bank deposits?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "It is no one else's liability",
                "comment": {
                  "@type": "Comment",
                  "text": "Stocks rely on the issuing company, bonds on the issuer's solvency, and bank deposits on the bank. Physical gold doesn't depend on any counterparty."
                }
              },
              "suggestedAnswer": [
                {
                  "@type": "Answer",
                  "text": "It pays a yield"
                },
                {
                  "@type": "Answer",
                  "text": "It is FDIC-insured"
